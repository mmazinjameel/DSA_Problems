   "source": [
    "from functools import reduce\n",
    "\n",
    "class Solution:\n",
    "    def doesValidArrayExist(self, derived: List[int]) -> bool:\n",
    "        return reduce(lambda a, b: a ^ b, derived, 0) == 0"
   ]
