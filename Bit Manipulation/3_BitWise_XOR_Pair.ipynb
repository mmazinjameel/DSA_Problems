   "source": [
    "class Solution:\n",
    "    def xorAllNums(self, nums1: List[int], nums2: List[int]) -> int:\n",
    "        ans = 0\n",
    "\n",
    "        if len(nums2) % 2:\n",
    "            for x in nums1:\n",
    "                ans ^= x\n",
    "\n",
    "        if len(nums1) % 2:\n",
    "            for x in nums2:\n",
    "                ans ^= x\n",
    "\n",
    "        return ans"
   ]
  }
