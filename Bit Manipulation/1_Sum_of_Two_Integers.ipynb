   "source": [
    "class Solution:\n",
    "    def getSum(self, a: int, b: int) -> int:\n",
    "        MASK = 0xFFFFFFFF\n",
    "        MAX_INT = 0x7FFFFFFF\n",
    "\n",
    "        while b != 0:\n",
    "            carry = (a & b) << 1\n",
    "            a = (a ^ b) & MASK\n",
    "            b = carry & MASK\n",
    "\n",
    "        return a if a <= MAX_INT else ~(a ^ MASK)"
   ]
  }
